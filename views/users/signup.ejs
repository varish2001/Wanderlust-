<% layout("/layouts/boilerplate") %>

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Join WanderLust</span>
        <h1>Create your account</h1>
        <p class="muted">Save listings, publish stays, and build your travel platform portfolio flow.</p>
        <form action="/signup" method="POST" class="needs-validation stack-form" novalidate>
            <div class="form-group">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" placeholder="Choose a username" type="text" class="form-control" required minlength="3">
                <div class="invalid-feedback">Please provide a username.</div>
            </div>
            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" placeholder="Enter your email" type="email" class="form-control" required>
                <div class="invalid-feedback">Please provide a valid email.</div>
            </div>
            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" placeholder="Choose a password" type="password" class="form-control" required minlength="6">
                <div class="invalid-feedback">Please provide a password with at least 6 characters.</div>
            </div>
            <button type="submit" class="btn btn-primary-soft submit-button">Create account</button>
        </form>
        <p class="auth-footer">Already have an account? <a href="/login">Log in</a></p>
    </div>
</section>
