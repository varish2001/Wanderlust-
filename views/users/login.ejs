<% layout("/layouts/boilerplate") %>

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Welcome back</span>
        <h1>Log in to WanderLust</h1>
        <p class="muted">Manage your listings, reviews, and wishlist from one clean dashboard.</p>
        <form action="/login" method="POST" class="needs-validation stack-form" novalidate>
            <div class="form-group">
                <label for="email" class="form-label">Email or username</label>
                <input name="email" id ="email" placeholder="Enter your email or username" type="text" class="form-control" required>
                <div class="invalid-feedback">Please provide a valid email or username.</div>
            </div>
            
            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input name="password" id ="password" placeholder="Enter your password" type="password" class="form-control" required minlength="6">
                <div class="invalid-feedback">Please provide your password.</div>
            </div>
            <button type="submit" class="btn btn-primary-soft submit-button">Log in</button>
        </form>
        <p class="auth-footer">Don’t have an account? <a href="/signup">Create one</a></p>
    </div>
</section>
