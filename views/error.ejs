<% layout("/layouts/boilerplate") %>

<section class="error-shell">
  <div class="error-card">
    <span class="eyebrow">Error <%= err.statusCode || 500 %></span>
    <h1><%= err.message %></h1>
    <p class="muted">
      <% if ((err.statusCode || 500) === 404) { %>
        The page you're looking for doesn't exist or may have been moved.
      <% } else { %>
        Something went wrong while processing your request. Please try again.
      <% } %>
    </p>
    <div class="hero-actions">
      <a href="/" class="btn btn-primary-soft">Back to home</a>
      <a href="/listings" class="btn btn-outline-dark">Browse listings</a>
    </div>
    <% if (err.stack) { %>
      <pre class="error-stack mt-4"><%= err.stack %></pre>
    <% } %>
  </div>
</section>
