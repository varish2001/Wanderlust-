<% layout("/layouts/boilerplate") %>

<section class="show-shell">
    <div class="show-hero">
        <div>
            <div class="listing-card-topline">
                <span class="pill"><%= listing.category %></span>
                <span class="muted"><%= listing.reviewCount || listing.reviews.length %> reviews</span>
            </div>
            <h1><%= listing.title %></h1>
            <p class="muted"><%= listing.location %>, <%= listing.country %></p>
            <div class="host-meta">
                <span>Hosted by <strong><%= listing.owner?.username || "WanderLust Host" %></strong></span>
                <span><%= listing.viewCount || 0 %> views</span>
            </div>
        </div>
        <% if (currUser) { %>
            <form method="POST" action="/listings/<%= listing._id %>/favorite">
                <button class="btn <%= isFavorite ? 'btn-outline-dark' : 'btn-primary-soft' %>">
                    <i class="fa-regular fa-heart"></i>
                    <%= isFavorite ? "Saved" : "Save to wishlist" %>
                </button>
            </form>
        <% } %>
    </div>

    <div class="show-grid">
        <article class="show-main-card">
            <img src="<%= listing.heroImage || listing.image %>" class="show-img" alt="<%= listing.title %>">
            <div class="show-content">
                <p><%= listing.description %></p>
                <div class="facts-grid">
                    <div><span>Price</span><strong>&#8377; <%= Number(listing.price || 0).toLocaleString("en-IN") %> / night</strong></div>
                    <div><span>Category</span><strong><%= listing.category %></strong></div>
                    <div><span>Location</span><strong><%= listing.location %></strong></div>
                    <div><span>Country</span><strong><%= listing.country %></strong></div>
                </div>
            </div>
        </article>

        <aside class="show-side-card">
            <h2>Stay highlights</h2>
            <ul class="detail-list">
                <li>Responsive listing layout with server-side rendered SEO-friendly markup</li>
                <li>Review-driven popularity signals and wishlist support</li>
                <li>Protected editing and deletion for listing owners</li>
            </ul>
            <% if (currUser && (!listing.owner || (listing.owner._id && listing.owner._id.equals(currUser._id)))) { %>
                <div class="stack-actions">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary-soft">Edit listing</a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-outline-dark w-100">Delete listing</button>
                    </form>
                </div>
            <% } %>
        </aside>
    </div>

    <section class="review-layout">
        <div class="review-panel">
            <div class="section-heading compact">
                <h2>Guest reviews</h2>
                <span class="muted"><%= listing.reviews.length %> total</span>
            </div>
            <% if (!listing.reviews.length) { %>
                <div class="empty-state">
                    <h3>No reviews yet</h3>
                    <p>Be the first traveler to share what this stay feels like.</p>
                </div>
            <% } %>
            <div class="review-grid">
                <% for (let review of listing.reviews) { %>
                    <article class="review-card">
                        <div class="review-card-top">
                            <div>
                                <h3><%= review.author?.username || "Guest" %></h3>
                                <p class="muted"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></p>
                            </div>
                            <span class="pill"><%= review.rating %>/5</span>
                        </div>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                        <p class="review-copy"><%= review.comment %></p>
                        <% if (currUser && review.author && review.author._id && review.author._id.equals(currUser._id)) { %>
                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-outline-dark">Delete review</button>
                            </form>
                        <% } %>
                    </article>
                <% } %>
            </div>
        </div>

        <% if (currUser) { %>
            <div class="review-form-panel">
                <h2>Leave a review</h2>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <legend class="visually-hidden">Rate this listing</legend>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" required />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                        </fieldset>
                    </div>

                    <div class="form-group">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" rows="5" class="form-control" placeholder="Share what stood out about the stay." required minlength="10"></textarea>
                        <div class="invalid-feedback">Please share a thoughtful review.</div>
                    </div>
                    <button type="submit" class="btn btn-primary-soft submit-button">Submit review</button>
                </form>
            </div>
        <% } else { %>
            <div class="review-form-panel">
                <h2>Want to leave a review?</h2>
                <p class="muted">Log in first so we can attach your feedback to your account.</p>
                <a href="/login" class="btn btn-primary-soft">Log in to review</a>
            </div>
        <% } %>
    </section>
</section>
